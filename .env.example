# Copy to .env and fill in. Never commit .env.
# Only needed for `npm run check-auth` (demo balance). Tick download/recording uses the public endpoint and needs no token.
DERIV_TOKEN=
DERIV_APP_ID=

# Railway Postgres. DATABASE_URL is set on the Railway recorder service (reference the Postgres service's variable).
# DATABASE_PUBLIC_URL is for your Mac only (npm run sync / seed-remote): enable Public Access on the Postgres service.
DATABASE_URL=
DATABASE_PUBLIC_URL=
